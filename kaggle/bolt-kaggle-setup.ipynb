    "\n",
    "# ============================================\n",
    "# CELL 6: FASTAPI SERVER SCRIPT\n",
    "# ============================================\n",
    "import os\n",
    "\n",
    "server_code = r'''\n",
    "from fastapi import FastAPI, HTTPException\n",
    "from fastapi.middleware.cors import CORSMiddleware\n",
    "from fastapi.responses import StreamingResponse\n",
    "from pydantic import BaseModel\n",
    "from typing import List, Optional\n",
    "import uvicorn, time, json, asyncio\n",
    "\n",
    "app = FastAPI(\n",
    "    title=\"Beast AI Server\",\n",
    "    description=\"Qwen3.6-35B Aggressive via Kaggle GPU\",\n",
    "    version=\"1.0.0\"\n",
    ")\n",
    "\n",
    "app.add_middleware(\n",
    "    CORSMiddleware,\n",
    "    allow_origins=[\"*\"],\n",
    "    allow_credentials=True,\n",
    "    allow_methods=[\"*\"],\n",
    "    allow_headers=[\"*\"],\n",
    ")\n",
    "\n",
    "class Message(BaseModel):\n",
    "    role: str\n",
    "    content: str\n",
    "\n",
    "class ChatRequest(BaseModel):\n",
    "    model: Optional[str] = \"qwen3.6-35b-aggressive\"\n",
    "    messages: List[Message]\n",
    "    max_tokens: Optional[int] = 2048\n",
    "    temperature: Optional[float] = 0.7\n",
    "    top_p: Optional[float] = 0.9\n",
    "    stream: Optional[bool] = False\n",
    "    stop: Optional[List[str]] = None\n",
    "\n",
    "def messages_to_prompt(messages):\n",
    "    prompt = \"\"\n",
    "    for msg in messages:\n",
    "        role = msg.role if msg.role in (\"system\", \"user\", \"assistant\") else \"user\"\n",
    "        prompt += f\"<|im_start|>{role}\\n{msg.content}<|im_end|>\\n\"\n",
    "    prompt += \"<|im_start|>assistant\\n\"\n",
    "    return prompt\n",
    "\n",
    "@app.get(\"/\")\n",
    "@app.get(\"/health\")\n",
    "async def health():\n",
    "    return {\n",
    "        \"status\": \"alive\",\n",
    "        \"model\": \"Qwen3.6-35B-A3B-Uncensored-Q4_K_M\",\n",
    "        \"platform\": \"Kaggle GPU T4\"\n",
    "    }\n",
    "\n",
    "@app.get(\"/v1/models\")\n",
    "async def list_models():\n",
    "    return {\n",
    "        \"object\": \"list\",\n",
    "        \"data\": [{\n",
    "            \"id\": \"qwen3.6-35b-aggressive\",\n",
    "            \"object\": \"model\",\n",
    "            \"created\": int(time.time()),\n",
    "            \"owned_by\": \"HauhauCS\",\n",
    "            \"permission\": [],\n",
    "            \"root\": \"qwen3.6-35b-aggressive\"\n",
    "        }]\n",
    "    }\n",
    "\n",
    "@app.post(\"/v1/chat/completions\")\n",
    "async def chat_completions(request: ChatRequest):\n",
    "    try:\n",
    "        prompt = messages_to_prompt(request.messages)\n",
    "        stop_tokens = request.stop or [\n",
    "            \"<|im_end|>\", \"<|im_start|>\", \"<|endoftext|>\"\n",
    "        ]\n",
    "\n",
    "        if request.stream:\n",
    "            async def stream_generator():\n",
    "                response_id = f\"chatcmpl-{int(time.time())}\"\n",
    "                first = {\n",
    "                    \"id\": response_id, \"object\": \"chat.completion.chunk\",\n",
    "                    \"created\": int(time.time()), \"model\": request.model,\n",
    "                    \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\"}, \"finish_reason\": None}]\n",
    "                }\n",
    "                yield f\"data: {json.dumps(first)}\\n\\n\"\n",
    "\n",
    "                stream = llm(\n",
    "                    prompt,\n",
    "                    max_tokens=request.max_tokens or 2048,\n",
    "                    temperature=request.temperature or 0.7,\n",
    "                    top_p=request.top_p or 0.9,\n",
    "                    stop=stop_tokens,\n",
    "                    echo=False, stream=True,\n",
    "                )\n",
    "\n",
    "                for chunk in stream:\n",
    "                    token = chunk[\"choices\"][0].get(\"text\", \"\")\n",
    "                    if token:\n",
    "                        data = {\n",
    "                            \"id\": response_id, \"object\": \"chat.completion.chunk\",\n",
    "                            \"created\": int(time.time()), \"model\": request.model,\n",
    "                            \"choices\": [{\"index\": 0, \"delta\": {\"content\": token}, \"finish_reason\": None}]\n",
    "                        }\n",
    "                        yield f\"data: {json.dumps(data)}\\n\\n\"\n",
    "                        await asyncio.sleep(0)\n",
    "\n",
    "                final = {\n",
    "                    \"id\": response_id, \"object\": \"chat.completion.chunk\",\n",
    "                    \"created\": int(time.time()), \"model\": request.model,\n",
    "                    \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}]\n",
    "                }\n",
    "                yield f\"data: {json.dumps(final)}\\n\\n\"\n",
    "                yield \"data: [DONE]\\n\\n\"\n",
    "\n",
    "            return StreamingResponse(\n",
    "                stream_generator(),\n",
    "                media_type=\"text/event-stream\",\n",
    "                headers={\"Cache-Control\": \"no-cache\", \"X-Accel-Buffering\": \"no\"}\n",
    "            )\n",
    "\n",
    "        output = llm(\n",
    "            prompt,\n",
    "            max_tokens=request.max_tokens or 2048,\n",
    "            temperature=request.temperature or 0.7,\n",
    "            top_p=request.top_p or 0.9,\n",
    "            stop=stop_tokens,\n",
    "            echo=False,\n",
    "        )\n",
    "\n",
    "        response_text = output[\"choices\"][0][\"text\"].strip()\n",
    "        usage = output.get(\"usage\", {})\n",
    "\n",
    "        return {\n",
    "            \"id\": f\"chatcmpl-{int(time.time())}\",\n",
    "            \"object\": \"chat.completion\",\n",
    "            \"created\": int(time.time()),\n",
    "            \"model\": request.model,\n",
    "            \"choices\": [{\n",
    "                \"index\": 0,\n",
    "                \"message\": {\"role\": \"assistant\", \"content\": response_text},\n",
    "                \"finish_reason\": \"stop\"\n",
    "            }],\n",
    "            \"usage\": {\n",
    "                \"prompt_tokens\": usage.get(\"prompt_tokens\", 0),\n",
    "                \"completion_tokens\": usage.get(\"completion_tokens\", 0),\n",
    "                \"total_tokens\": usage.get(\"total_tokens\", 0)\n",
    "            }\n",
    "        }\n",
    "\n",
    "    except Exception as e:\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "        raise HTTPException(status_code=500, detail=str(e))\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    uvicorn.run(app, host=\"0.0.0.0\", port=8000, workers=1)\n",
    "'''\n",
    "\n",
    "with open(\"/kaggle/working/server.py\", \"w\") as f:\n",
    "    f.write(server_code)\n",
    "\n",
    "print(\"Server script saved: /kaggle/working/server.py\")"
   ]
  },
