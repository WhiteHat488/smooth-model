    "\n",
    "# ============================================\n",
    "# CELL 7: SERVER + CLOUDFLARE TUNNEL + AUTO UPDATE\n",
    "# IMPORTANT: Apna CF_ACCOUNT_ID aur CF_API_TOKEN daalo\n",
    "# ============================================\n",
    "\n",
    "import subprocess, threading, time, re, sys\n",
    "import builtins, importlib.util, uvicorn, os, requests\n",
    "\n",
    "# ══════════════════════════════════════════════\n",
    "# APNI VALUES YAHAN DAALO\n",
    "CF_ACCOUNT_ID  = \"7f3e6ebdc521ae2219fd9610dcbb364f\"   # Dashboard se lo\n",
    "CF_WORKER_NAME = \\"kaggle-ai-proxy\\"               # Worker ka naam\n",
    "CF_API_TOKEN   = \"your_cloudflare_api_token_here\"             # Edit Workers permission wala\n",
    "# ══════════════════════════════════════════════\n",
    "\n",
    "if not hasattr(builtins, \"llm\") or builtins.llm is None:\n",
    "    raise RuntimeError(\"llm not loaded! Run Cell 5 first.\")\n",
    "\n",
    "sys.path.insert(0, \"/kaggle/working\")\n",
    "\n",
    "spec = importlib.util.spec_from_file_location(\"server\", \"/kaggle/working/server.py\")\n",
    "server_module = importlib.util.module_from_spec(spec)\n",
    "server_module.llm = builtins.llm\n",
    "sys.modules[\"server\"] = server_module\n",
    "spec.loader.exec_module(server_module)\n",
    "\n",
    "def run_server():\n",
    "    uvicorn.run(\n",
    "        server_module.app,\n",
    "        host=\"0.0.0.0\",\n",
    "        port=8000,\n",
    "        log_level=\"warning\",\n",
    "        access_log=False\n",
    "    )\n",
    "\n",
    "server_thread = threading.Thread(target=run_server, daemon=True)\n",
    "server_thread.start()\n",
    "print(\"FastAPI server starting on port 8000...\")\n",
    "time.sleep(5)\n",
    "\n",
    "try:\n",
    "    r = requests.get(\"http://127.0.0.1:8000/health\", timeout=5)\n",
    "    print(f\"Local health: {r.status_code} — {r.json()['status']}\")\n",
    "except Exception as e:\n",
    "    print(f\"Local check: {e}\")\n",
    "\n",
    "print(\"\\nStarting Cloudflare tunnel...\")\n",
    "cf_bin = \"/kaggle/working/cloudflared\"\n",
    "\n",
    "cf_process = subprocess.Popen(\n",
    "    [cf_bin, \"tunnel\", \"--url\", \"http://localhost:8000\", \"--no-autoupdate\"],\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.STDOUT,\n",
    "    text=True, bufsize=1\n",
    ")\n",
    "\n",
    "cloudflare_url = None\n",
    "print(\"Waiting for URL (10-30 sec)...\")\n",
    "\n",
    "for i, line in enumerate(cf_process.stdout):\n",
    "    if \"trycloudflare.com\" in line:\n",
    "        urls = re.findall(r'https://[a-zA-Z0-9\\-]+\\.trycloudflare\\.com', line)\n",
    "        if urls:\n",
    "            cloudflare_url = urls[0]\n",
    "            break\n",
    "    if i > 80:\n",
    "        break\n",
    "\n",
    "def update_cloudflare_worker(tunnel_url: str):\n",
    "    \"\"\"Cloudflare Worker ka KAGGLE_TUNNEL_URL auto update karo\"\"\"\n",
    "    url = (\n",
    "        f\"https://api.cloudflare.com/client/v4/accounts/\"\n",
    "        f\"{CF_ACCOUNT_ID}/workers/scripts/{CF_WORKER_NAME}/secrets\"\n",
    "    )\n",
    "    payload = {\n",
    "        \"name\": \"KAGGLE_TUNNEL_URL\",\n",
    "        \"text\": tunnel_url,\n",
