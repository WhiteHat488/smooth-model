    "\n",
    "# ============================================\n",
    "# CELL 1: SYSTEM CHECK\n",
    "# ============================================\n",
    "import os\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"  SYSTEM CHECK\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "try:\n",
    "    gpu = subprocess.run(\n",
    "        [\"nvidia-smi\", \"--query-gpu=name,memory.total,memory.free\",\n",
    "         \"--format=csv,noheader\"],\n",
    "        capture_output=True, text=True, timeout=10\n",
    "    )\n",
    "    print(f\"\\nGPU Info:\\n   {gpu.stdout.strip()}\")\n",
    "except Exception as e:\n",
    "    print(f\"\\nGPU Info: Error - {e}\")\n",
    "\n",
    "try:\n",
    "    ram = subprocess.run([\"free\", \"-h\"], capture_output=True, text=True)\n",
    "    print(f\"\\nRAM Info:\\n{ram.stdout}\")\n",
    "except:\n",
    "    print(\"\\nRAM: free command failed\")\n",
    "\n",
    "try:\n",
    "    disk = subprocess.run([\"df\", \"-h\", \"/kaggle\"], capture_output=True, text=True)\n",
    "    print(f\"Disk (/kaggle):\\n{disk.stdout}\")\n",
    "except:\n",
    "    pass\n",
    "\n",
    "print(f\"\\nPython: {sys.version}\")\n",
    "print(\"=\" * 60)\n",
    "print(\"System check complete!\")\n",
    "print(\"=\" * 60)"
   ]
  },
