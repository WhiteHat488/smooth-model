    "\n",
    "# ============================================\n",
    "# CELL 3: DOWNLOAD MODEL (~21 GB, 15-40 min)\n",
    "# ============================================\n",
    "from huggingface_hub import hf_hub_download\n",
    "import os\n",
    "\n",
    "SAVE_PATH  = \"/kaggle/tmp/models\"\n",
    "FILE_NAME  = \"Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf\"\n",
    "FINAL_PATH = os.path.join(SAVE_PATH, FILE_NAME)\n",
    "REPO_ID    = \"HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive\"\n",
    "\n",
    "os.makedirs(SAVE_PATH, exist_ok=True)\n",
    "\n",
    "if os.path.exists(FINAL_PATH):\n",
    "    size_gb = os.path.getsize(FINAL_PATH) / (1024**3)\n",
    "    if 20.0 <= size_gb <= 22.5:\n",
    "        print(f\"Model already downloaded! Size: {size_gb:.2f} GB\")\n",
    "        MODEL_PATH = FINAL_PATH\n",
    "        print(f\"MODEL_PATH = {MODEL_PATH}\")\n",
    "        # Skip download\n",
    "        import sys\n",
    "        print(\"Skipping download — use Cell 4 to verify\")\n",
    "    else:\n",
    "        print(f\"Incomplete file ({size_gb:.2f} GB) — deleting...\")\n",
    "        os.remove(FINAL_PATH)\n",
    "else:\n",
    "    print(f\"Starting fresh download...\")\n",
    "    print(f\"File: {FILE_NAME}\")\n",
    "    print(f\"Saving to: {SAVE_PATH}\")\n",
    "    print(f\"ETA: 15-40 min\\n\")\n",
    "\n",
    "    hf_hub_download(\n",
    "        repo_id=REPO_ID,\n",
    "        filename=FILE_NAME,\n",
    "        local_dir=SAVE_PATH,\n",
    "        local_dir_use_symlinks=False,\n",
    "        force_download=False,\n",
    "        resume_download=True,\n",
    "    )\n",
    "\n",
    "if os.path.exists(FINAL_PATH):\n",
    "    size_gb = os.path.getsize(FINAL_PATH) / (1024**3)\n",
    "    print(f\"\\nDownload complete! Size: {size_gb:.2f} GB\")\n",
    "    if 20.0 <= size_gb <= 22.5:\n",
    "        print(\"File complete — ready to load!\")\n",
    "        MODEL_PATH = FINAL_PATH\n",
    "    else:\n",
    "        print(f\"Size unexpected ({size_gb:.2f} GB). Retry.\")\n",
    "else:\n",
    "    print(\"Download failed!\")"
   ]
  },
