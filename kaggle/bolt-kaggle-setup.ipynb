    "\n",
    "# ============================================\n",
    "# CELL 5: LOAD MODEL\n",
    "# ============================================\n",
    "from llama_cpp import Llama\n",
    "import os\n",
    "import builtins\n",
    "\n",
    "MODEL_PATH = \"/kaggle/tmp/models/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf\"\n",
    "\n",
    "if not os.path.exists(MODEL_PATH):\n",
    "    import subprocess\n",
    "    res = subprocess.run(\n",
    "        [\"find\", \"/kaggle\", \"/tmp\", \"-name\", \"*Qwen3.6*Q4_K_M*.gguf\", \"-type\", \"f\"],\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if res.stdout.strip():\n",
    "        MODEL_PATH = res.stdout.strip().split(\"\\n\")[0]\n",
    "        print(f\"Found: {MODEL_PATH}\")\n",
    "    else:\n",
    "        raise FileNotFoundError(\"Model not found! Run Cell 3.\")\n",
    "\n",
    "print(f\"Loading model: {MODEL_PATH}\")\n",
    "print(\"First load: 1-3 minutes...\")\n",
    "\n",
    "llm = Llama(\n",
    "    model_path=MODEL_PATH,\n",
    "    n_gpu_layers=-1,\n",
    "    n_ctx=8192,\n",
    "    n_batch=512,\n",
    "    n_threads=8,\n",
    "    verbose=False,\n",
    "    seed=42,\n",
    "    use_mmap=True,\n",
    "    use_mlock=False,\n",
    ")\n",
    "\n",
    "builtins.llm = llm\n",
    "globals()[\"llm\"] = llm\n",
    "\n",
    "print(\"\\nModel loaded!\")\n",
    "print(f\"Context: {llm.n_ctx()}\")\n",
    "\n",
    "# Smoke test\n",
    "out = llm(\n",
    "    \"<|im_start|>user\\nSay hello in one sentence.<|im_end|>\\n<|im_start|>assistant\\n\",\n",
    "    max_tokens=30, temperature=0.7, echo=False\n",
    ")\n",
    "print(\"Smoke test:\", out[\"choices\"][0][\"text\"].strip())\n",
    "print(\"Ready for server!\")"
   ]
